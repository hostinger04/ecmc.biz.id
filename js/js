// Helper function to save data to JSON files (simulated)
function saveDataToFile(filename, data) {
    // In a real app, this would send data to a server
    console.log(`Simulating save to ${filename}:`, data);
    // For this demo, we'll just update the in-memory data
    if (filename === 'data.json') {
        accounts = data;
    } else if (filename === 'pesanan.json') {
        orders = data;
    } else if (filename === 'topup.json') {
        topups = data;
    }
}
